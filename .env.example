# ── Ambiente primario ─────────────────────────────────────────────────────────
# Nombre que aparece en el selector (opcional, default: "Desarrollo")
VITE_ENV_LABEL=Desarrollo

VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_HOSTED_UI_DOMAIN=tu-dominio.auth.us-east-1.amazoncognito.com

# Lista de App Clients a mostrar en el selector (opcional)
# Formato: clientId:etiqueta,clientId2:etiqueta2
VITE_COGNITO_APP_CLIENTS=id1:staff-web,id2:sunwise-web,id3:sunpay-web

# ── Ambiente adicional (repetir con ENV_3, ENV_4, … para más) ─────────────────
VITE_ENV_2_LABEL=Producción
VITE_ENV_2_COGNITO_REGION=us-east-1
VITE_ENV_2_COGNITO_USER_POOL_ID=us-east-1_YYYYYYYYY
VITE_ENV_2_COGNITO_USER_POOL_CLIENT_ID=YYYYYYYYYYYYYYYYYYYYYYYYYY
VITE_ENV_2_COGNITO_HOSTED_UI_DOMAIN=prod-dominio.auth.us-east-1.amazoncognito.com
VITE_ENV_2_COGNITO_APP_CLIENTS=idA:staff-web,idB:sunwise-web,idC:sunpay-web

# ── SSO (opcional) ─────────────────────────────────────────────────────────────
# Redirect URI override para el flujo SSO sunwise-web (default: <origin>/callback)
# VITE_SSO_SUNWISE_REDIRECT_URI=https://app.sunwise.io/callback

# ── Debug ─────────────────────────────────────────────────────────────────────
# VITE_DEBUG_AUTH=true
